VITE_ANALYTICS_WEBSITE_ID=local
VITE_ANALYTICS_ENDPOINT=http://localhost:3000/analytics
OAUTH_SERVER_URL=http://localhost:3000
VITE_OAUTH_PORTAL_URL=http://localhost:3000
VITE_APP_ID=tiago-analyse-pro

# A chave real fica no arquivo .env.local
API_FOOTBALL_KEY=

# TheSportsDB gratuito: use 123 se não tiver chave premium
THESPORTSDB_API_KEY=123

# Admin inicial
ADMIN_NAME=TIAGO OLIVEIRA
ADMIN_EMAIL=admin@tiagoanalysepro.com
ADMIN_PASSWORD=troque-esta-senha

# Mercado Pago Checkout Pro (use credencial de TESTE enquanto valida a integração)
MERCADO_PAGO_ACCESS_TOKEN=
# test = sandbox; production = pagamentos reais
MERCADO_PAGO_MODE=test
# Copie do painel de Webhooks do Mercado Pago
MERCADO_PAGO_WEBHOOK_SECRET=
APP_URL=https://tiago-analyse-pro-production.up.railway.app

# Recuperação de senha por e-mail (opcional enquanto estiver em desenvolvimento)
RESEND_API_KEY=
RESET_EMAIL_FROM=ANALYSE PRO 2.0 <no-reply@seudominio.com>
# Ative somente em testes para abrir o link de recuperação na própria tela
ALLOW_RESET_PREVIEW=false


# Controle de consumo API-Football — configurado para MEGA Plan
API_FOOTBALL_DAILY_LIMIT=150000
# Pausa rankings/análises ao chegar neste número e guarda reserva para ao vivo
API_FOOTBALL_SAFETY_LIMIT=120000
API_FOOTBALL_ESSENTIAL_RESERVE=30000
# Defina conforme o limite por minuto exibido no seu plano/painel da API
API_FOOTBALL_PER_MINUTE_LIMIT=850

# Limite diário por utilizador para geração/comparação de análises
API_ANALYSIS_LIMIT_FREE=10
API_ANALYSIS_LIMIT_PRO=80
API_ANALYSIS_LIMIT_VIP=200
API_ANALYSIS_LIMIT_SOCIO_VIP=500

# Monte um volume Railway neste diretório para o contador não reiniciar após deploy
DATA_DIR=/data


# Assinaturas Mercado Pago
# Além do evento Pagamentos, configure no webhook:
# subscription_preapproval e subscription_authorized_payment

# Ative para testar o site sem gastar API real: true ou false
DEMO_MODE=false
